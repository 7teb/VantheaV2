{
  "name": "vantheax",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "node --test \"tests/**/*.test.ts\"",
    "build": "npm.cmd run typecheck && vite build && node scripts/build-main.mjs",
    "start": "electron .",
    "package": "npm.cmd run build && electron-builder --win dir",
    "dist": "npm.cmd run build && electron-builder --win nsis"
  },
  "build": {
    "appId": "dev.local.vantheax",
    "productName": "VantheaX",
    "directories": {
      "output": "outputs/electron"
    },
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "config/**/*",
      "Resources/**/*",
      "package.json",
      "!node_modules/node-pty/{deps,src,third_party}/**",
      "!node_modules/node-pty/prebuilds/{darwin-x64,darwin-arm64,linux-x64,linux-arm64,win32-arm64}/**",
      "!node_modules/node-pty/prebuilds/**/*.pdb"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "win": {
      "target": [
        "dir"
      ],
      "icon": "Resources/VantheaX.ico"
    },
    "asar": true
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.27.7",
    "highlight.js": "^11.11.1",
    "katex": "^0.17.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.2.7"
  }
}
